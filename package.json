{
  "name": "gabion-audit",
  "version": "0.3.0",
  "description": "Judges the npm trees a repository's consumers install and the vulnerabilities a scan of its compositions reports against known advisories: only a finding without a declared reason fails",
  "license": "BUSL-1.1",
  "author": "Pikiner, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabion-dev/gabion-audit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gabion-audit": "dist/cli/gabion-audit.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/mark-executable.js",
    "prebuild": "node scripts/clean-dist.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "audit:self": "npm run build && node dist/cli/gabion-audit.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
